# ========================================================
# NVIDIA x Nebius Hackathon - JARVIS AI Assistant Config
# ========================================================

# NVIDIA NIM API (https://build.nvidia.com)
# Base URL: https://integrate.api.nvidia.com/v1
# Popular models: 
#   - meta/llama-3.3-70b-instruct
#   - nvidia/llama-3.1-nemotron-70b-instruct
#   - meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Nebius AI Studio (https://studio.nebius.ai)
# Base URL: https://api.studio.nebius.ai/v1
# Popular models:
#   - meta-llama/Llama-3.3-70B-Instruct-fast
#   - meta-llama/Meta-Llama-3.1-70B-Instruct
#   - meta-llama/Meta-Llama-3.1-8B-Instruct
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-fast

# Provider Selection: "auto" (load-balance/fallback), "nvidia", or "nebius"
DEFAULT_AI_PROVIDER=auto

# Optional Email Dispatch (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=jarvis@assistant.local
