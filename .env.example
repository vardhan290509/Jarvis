# ========================================================
# NVIDIA x Nebius Hackathon - JARVIS AI Assistant Config
# ========================================================

# Google Gemini API (https://aistudio.google.com)
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai
# Models: gemini-2.5-flash, gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# NVIDIA NIM API (https://build.nvidia.com)
# Base URL: https://integrate.api.nvidia.com/v1
# Models: meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Nebius AI Studio (https://studio.nebius.ai)
# Base URL: https://api.studio.nebius.ai/v1
# Models: meta-llama/Llama-3.3-70B-Instruct-fast
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-fast

# Provider Selection: "gemini", "auto", "nebius", or "nvidia"
DEFAULT_AI_PROVIDER=gemini

# Optional Email Dispatch (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=jarvis@assistant.local
